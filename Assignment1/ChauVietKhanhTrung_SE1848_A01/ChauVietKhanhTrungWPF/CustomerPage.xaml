<Window x:Class="ChauVietKhanhTrungWPF.CustomerPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChauVietKhanhTrungWPF"
        mc:Ignorable="d"
        Title="Customer Management" Height="550" Width="950" 
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header với Search -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="Search Customer:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Medium"/>
                    <TextBox x:Name="SearchTextBox" Width="250" Height="32" Padding="8"
                     BorderBrush="#D0D0D0" BorderThickness="1" VerticalContentAlignment="Center"/>
                    <Button Content="Search" Width="80" Height="32" Margin="10,0,0,0"
                    Background="#007ACC" Foreground="White" BorderThickness="0"
                    Click="SearchButton_Click" Cursor="Hand"/>
                </StackPanel>
                <Button x:Name="Back_to_Admin" Content="Back to Admin" Grid.Column="1" Width="130" Height="32" Margin="30,0,0,0"
                Background="#1E293B" Foreground="White" BorderThickness="0"
                Click="BackToAdmin_Click" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <DataGrid x:Name="CustomerDataGrid" Grid.Row="1" AutoGenerateColumns="True" 
                  Margin="15" Background="White" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" CanUserAddRows="False" 
                  AlternatingRowBackground="#F9F9F9" RowHeight="30"/>

        <!-- Bottom Panel với các nút -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Add New Customer" Width="140" Height="35" Margin="0,0,10,0"
                        Background="#28A745" Foreground="White" BorderThickness="0"
                        Click="AddCustomer_Click" Cursor="Hand"/>
                <Button Content="Edit Customer" Width="120" Height="35" Margin="0,0,10,0"
                        Background="#FFC107" Foreground="Black" BorderThickness="0"
                        Click="EditCustomer_Click" Cursor="Hand"/>
                <Button Content="Delete Customer" Width="130" Height="35"
                        Background="#DC3545" Foreground="White" BorderThickness="0"
                        Click="DeleteCustomer_Click" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Popup Dialog -->
        <Popup x:Name="CustomerPopup" 
               PlacementTarget="{Binding ElementName=CustomerDataGrid}"
               Placement="Center"
               IsOpen="False" 
               StaysOpen="False"
               AllowsTransparency="True">
            <Border BorderBrush="#D0D0D0" BorderThickness="1" Background="White" 
                    CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                </Border.Effect>
                <Grid Width="420" Height="435" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0" Text="Customer Information" 
                               FontSize="16" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <!-- Company Name -->
                    <Label Grid.Row="1" Content="Company Name:" FontWeight="Medium" Padding="0,0,0,5"/>
                    <TextBox x:Name="CompanyNameTextBox" Grid.Row="1" Height="32" Margin="0,25,0,10"
                             Padding="8" BorderBrush="#D0D0D0" BorderThickness="1"/>

                    <!-- Contact Name -->
                    <Label Grid.Row="2" Content="Contact Name:" FontWeight="Medium" Padding="0,0,0,5"/>
                    <TextBox x:Name="ContactNameTextBox" Grid.Row="2" Height="32" Margin="0,25,0,10"
                             Padding="8" BorderBrush="#D0D0D0" BorderThickness="1"/>

                    <!-- Contact Title -->
                    <Label Grid.Row="3" Content="Contact Title:" FontWeight="Medium" Padding="0,0,0,5"/>
                    <TextBox x:Name="ContactTitleTextBox" Grid.Row="3" Height="32" Margin="0,25,0,10"
                             Padding="8" BorderBrush="#D0D0D0" BorderThickness="1"/>

                    <!-- Address -->
                    <Label Grid.Row="4" Content="Address:" FontWeight="Medium" Padding="0,0,0,5"/>
                    <TextBox x:Name="AddressTextBox" Grid.Row="4" Height="32" Margin="0,25,0,10"
                             Padding="8" BorderBrush="#D0D0D0" BorderThickness="1"/>

                    <!-- Phone -->
                    <Label Grid.Row="5" Content="Phone:" FontWeight="Medium" Padding="0,0,0,5"/>
                    <TextBox x:Name="PhoneTextBox" Grid.Row="5" Height="32" Margin="0,25,0,15"
                             Padding="8" BorderBrush="#D0D0D0" BorderThickness="1"/>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button Content="Save" Width="80" Height="35" Margin="0,0,15,0"
                                Background="#007ACC" Foreground="White" BorderThickness="0"
                                Click="SaveButton_Click" Cursor="Hand"/>
                        <Button Content="Cancel" Width="80" Height="35"
                                Background="#6C757D" Foreground="White" BorderThickness="0"
                                Click="CancelButton_Click" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>