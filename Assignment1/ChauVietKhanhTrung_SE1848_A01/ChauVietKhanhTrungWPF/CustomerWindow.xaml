<Window x:Class="ChauVietKhanhTrungWPF.CustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer Dashboard" Height="650" Width="950"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Background="#F8F9FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Search -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="Search Order:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Medium" Foreground="#495057"/>
                    <TextBox x:Name="SearchTextBox" Width="250" Height="32" Padding="8" BorderBrush="#CED4DA" BorderThickness="1" VerticalContentAlignment="Center"/>
                    <Button Content="Search" Width="80" Height="32" Margin="10,0,0,0" Background="#007ACC" Foreground="White" BorderThickness="0" Click="SearchButton_Click" Cursor="Hand" FontWeight="Medium"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid for Orders -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Margin="15">
            <DataGrid x:Name="OrderDataGrid" AutoGenerateColumns="True" Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column" CanUserAddRows="False" AlternatingRowBackground="#F8F9FA" RowHeight="35" FontSize="13" Foreground="#495057"/>
        </Border>

        <!-- Bottom Panel with buttons -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Edit Profile" Width="140" Height="35" Margin="0,0,10,0" Background="#28A745" Foreground="White" BorderThickness="0" Click="EditProfile_Click" Cursor="Hand" FontWeight="Medium">
                    <Button.Effect>
                        <DropShadowEffect Color="#28A745" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                    </Button.Effect>
                </Button>
                <Button Content="Log Out" Width="120" Height="35" Background="#DC3545" Foreground="White" BorderThickness="0" Click="LogoutButton_Click" Cursor="Hand" FontWeight="Medium">
                    <Button.Effect>
                        <DropShadowEffect Color="#DC3545" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                    </Button.Effect>
                </Button>
            </StackPanel>
        </Border>

        <!-- Popup for editing personal information -->
        <Popup x:Name="ProfilePopup" Placement="Center" IsOpen="False" StaysOpen="False" AllowsTransparency="True">
            <Border BorderBrush="#D0D0D0" BorderThickness="1" Background="White">
                <Grid Width="420" Height="550" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0" Text="Edit Profile" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,25" Foreground="#343A40"/>

                    <!-- Company Name -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <Label Content="Company Name:" FontWeight="Medium" Padding="0,0,0,5" Foreground="#495057"/>
                        <TextBox x:Name="CompanyNameTextBox" Height="40" Padding="10" BorderBrush="#CED4DA" BorderThickness="1" FontSize="13"/>
                    </StackPanel>

                    <!-- Contact Name -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,15">
                        <Label Content="Contact Name:" FontWeight="Medium" Padding="0,0,0,5" Foreground="#495057"/>
                        <TextBox x:Name="ContactNameTextBox" Height="40" Padding="10" BorderBrush="#CED4DA" BorderThickness="1" FontSize="13"/>
                    </StackPanel>

                    <!-- Contact Title -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,15">
                        <Label Content="Contact Title:" FontWeight="Medium" Padding="0,0,0,5" Foreground="#495057"/>
                        <TextBox x:Name="ContactTitleTextBox" Height="40" Padding="10" BorderBrush="#CED4DA" BorderThickness="1" FontSize="13"/>
                    </StackPanel>

                    <!-- Address -->
                    <StackPanel Grid.Row="4" Margin="0,0,0,15">
                        <Label Content="Address:" FontWeight="Medium" Padding="0,0,0,5" Foreground="#495057"/>
                        <TextBox x:Name="AddressTextBox" Height="40" Padding="10" BorderBrush="#CED4DA" BorderThickness="1" FontSize="13"/>
                    </StackPanel>

                    <!-- Phone -->
                    <StackPanel Grid.Row="5" Margin="0,0,0,15">
                        <Label Content="Phone:" FontWeight="Medium" Padding="0,0,0,5" Foreground="#495057"/>
                        <TextBox x:Name="PhoneTextBox" Height="40" Padding="10" BorderBrush="#CED4DA" BorderThickness="1" FontSize="13"/>
                    </StackPanel>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button Content="Save" Width="90" Height="38" Margin="0,0,15,0" Background="#007ACC" Foreground="White" BorderThickness="0" Click="SaveProfile_Click" Cursor="Hand" FontWeight="Medium" FontSize="13">
                            <Button.Effect>
                                <DropShadowEffect Color="#007ACC" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                            </Button.Effect>
                        </Button>
                        <Button Content="Cancel" Width="90" Height="38" Background="#6C757D" Foreground="White" BorderThickness="0" Click="CancelProfile_Click" Cursor="Hand" FontWeight="Medium" FontSize="13">
                            <Button.Effect>
                                <DropShadowEffect Color="#6C757D" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                            </Button.Effect>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
