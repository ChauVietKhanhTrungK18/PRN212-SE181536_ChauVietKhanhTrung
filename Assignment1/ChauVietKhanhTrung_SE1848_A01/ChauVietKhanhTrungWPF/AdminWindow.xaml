<Window x:Class="ChauVietKhanhTrungWPF.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChauVietKhanhTrungWPF"
        mc:Ignorable="d"
        Title="Admin Dashboard" Height="600" Width="1000" 
        WindowStartupLocation="CenterScreen"
        MinHeight="500" MinWidth="800">

    <Window.Resources>
        <!-- Color Resources -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#2563eb"/>
        <SolidColorBrush x:Key="SecondaryColor" Color="#f8fafc"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1e293b"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748b"/>
        <SolidColorBrush x:Key="BorderColor" Color="#e2e8f0"/>
        <SolidColorBrush x:Key="HoverColor" Color="#3b82f6"/>

        <!-- Button Style -->
        <Style TargetType="Button" x:Key="MenuButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" 
                                BorderThickness="0" CornerRadius="6" Margin="8,2">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" 
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#f1f5f9"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#e2e8f0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stat Card Style -->
        <Style TargetType="Border" x:Key="StatCard">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="10" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource SecondaryColor}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="White" 
                BorderThickness="0,0,1,0" BorderBrush="{StaticResource BorderColor}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo/Title Section -->
                <Border Grid.Row="0" Background="{StaticResource PrimaryColor}" Padding="20,24">
                    <TextBlock Text="ADMIN PANEL" 
                               FontWeight="Bold" 
                               FontSize="16" 
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Navigation Menu -->
                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <TextBlock Text="MANAGEMENT" 
                               FontWeight="SemiBold" 
                               FontSize="12" 
                               Margin="20,0,20,16" 
                               Foreground="{StaticResource TextSecondary}"
                               />

                    <Button x:Name="btnCustomers" Content="👥 Customers" 
                            Style="{StaticResource MenuButton}" 
                            Click="ManageCustomers_Click"/>
                    <Button x:Name="btnProducts" Content="📦 Products" 
                            Style="{StaticResource MenuButton}" 
                            Click="ManageProducts_Click"/>
                    <Button x:Name="btnOrders" Content="🛒 Orders" 
                            Style="{StaticResource MenuButton}" 
                            Click="CreateOrder_Click"/>
                    <Button x:Name="btnReports" Content="📊 Reports" 
                            Style="{StaticResource MenuButton}" 
                            Click="GenerateReport_Click"/>
                </StackPanel>

                <!-- User Info Section -->
                <Border Grid.Row="2" Background="#f8fafc" Padding="20,16" 
                        BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderColor}">
                    <StackPanel>
                        <TextBlock Text="👤 Administrator" 
                                   FontWeight="Medium" 
                                   FontSize="14" 
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="admin@system.com" 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextSecondary}" 
                                   Margin="0,4,0,0"/>
                        <Button x:Name="LogoutButton" Content="Logout" 
                            Style="{StaticResource MenuButton}" 
                            Click="LogoutButton_Click" 
                            Margin="0,15,150,0"
                            Background="#FF007ACC" 
                            Foreground="White"
                            FontWeight="Bold"
                            Padding="10,10"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="32,24,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,32">
                <TextBlock Text="Dashboard Overview" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Welcome back! Here's what's happening with your business today." 
                           FontSize="16" 
                           Foreground="{StaticResource TextSecondary}" 
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Stats Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Customers Card -->
                <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="Total Customers" 
                                   FontSize="14" 
                                   FontWeight="Medium" 
                                   Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="TotalCustomersTextBlock" 
                                   Text="" 
                                   FontSize="32" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimary}" 
                                   Margin="0,8,0,0"/>

                    </StackPanel>
                </Border>

                <!-- Total Products Card -->
                <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="Total Products" 
                                   FontSize="14" 
                                   FontWeight="Medium" 
                                   Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="TotalProductsTextBlock" 
                                   Text="" 
                                   FontSize="32" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimary}" 
                                   Margin="0,8,0,0"/>

                    </StackPanel>
                </Border>

                <!-- Total Orders Card -->
                <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="16,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Total Orders" 
                                   FontSize="14" 
                                   FontWeight="Medium" 
                                   Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="TotalOrdersTextBlock" 
                                   Text="" 
                                   FontSize="32" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimary}" 
                                   Margin="0,8,0,0"/>
                        
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>