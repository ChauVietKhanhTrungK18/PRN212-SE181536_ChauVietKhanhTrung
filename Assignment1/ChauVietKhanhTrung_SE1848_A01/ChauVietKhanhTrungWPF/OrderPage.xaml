<Window x:Class="ChauVietKhanhTrungWPF.OrderPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Orders" Height="600" Width="950"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Background="#F8F9FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Search -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="15">
            <Border.Effect>
                <DropShadowEffect Color="Gray" BlurRadius="5" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="Search Order:" VerticalAlignment="Center" Margin="0,0,10,0" 
                              FontWeight="Medium" Foreground="#495057"/>
                    <TextBox x:Name="SearchTextBox" Width="250" Height="32" Padding="8"
                             BorderBrush="#CED4DA" BorderThickness="1" VerticalContentAlignment="Center"/>
                    <Button Content="Search" Width="80" Height="32" Margin="10,0,0,0"
                            Background="#007ACC" Foreground="White" BorderThickness="0"
                            Click="SearchButton_Click" Cursor="Hand" FontWeight="Medium"/>
                </StackPanel>
                <Button x:Name="BackToAdminButton" Content="Back to Admin" Grid.Column="1" 
                        Width="130" Height="32" Margin="30,0,0,0"
                        Background="#6C757D" Foreground="White" BorderThickness="0"
                        Click="BackToAdmin_Click" Cursor="Hand" FontWeight="Medium"/>
            </Grid>
        </Border>

        <!-- DataGrid for Orders -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" 
                Margin="15">
            <DataGrid x:Name="OrderDataGrid" AutoGenerateColumns="True" 
                      Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" CanUserAddRows="False" 
                      AlternatingRowBackground="#F8F9FA" RowHeight="35"
                      FontSize="13" Foreground="#495057" Margin="1">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F1F3F4"/>
                        <Setter Property="Foreground" Value="#495057"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" 
                                           BorderBrush="{TemplateBinding BorderBrush}" 
                                           BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter VerticalAlignment="Center" 
                                                         Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>
            </DataGrid>
        </Border>

        <!-- Bottom Panel with buttons -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="15">
            <Border.Effect>
                <DropShadowEffect Color="Gray" BlurRadius="5" ShadowDepth="-2" Opacity="0.1"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Create Order" Width="140" Height="35" Margin="0,0,10,0"
                        Background="#28A745" Foreground="White" BorderThickness="0"
                        Click="CreateOrder_Click" Cursor="Hand" FontWeight="Medium">
                    <Button.Effect>
                        <DropShadowEffect Color="#28A745" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                    </Button.Effect>
                </Button>
                <Button Content="Delete Order" Width="130" Height="35"
                        Background="#DC3545" Foreground="White" BorderThickness="0"
                        Click="DeleteOrder_Click" Cursor="Hand" FontWeight="Medium">
                    <Button.Effect>
                        <DropShadowEffect Color="#DC3545" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                    </Button.Effect>
                </Button>
            </StackPanel>
        </Border>

        <!-- Popup for creating and editing orders -->
        <Popup x:Name="OrderPopup" 
               PlacementTarget="{Binding ElementName=OrderDataGrid}"
               Placement="Center" 
               IsOpen="False" 
               StaysOpen="False" 
               AllowsTransparency="True">
            <Border BorderBrush="#D0D0D0" BorderThickness="1" Background="White">
                <Border.Effect>
                    <DropShadowEffect Color="Gray" BlurRadius="15" ShadowDepth="5" Opacity="0.3"/>
                </Border.Effect>
                <Grid Width="420" Height="380" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0" Text="Order Information" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,25" Foreground="#343A40"/>

                    <!-- Customer ID -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <Label Content="Customer ID:" FontWeight="Medium" Padding="0,0,0,5" 
                               Foreground="#495057"/>
                        <TextBox x:Name="CustomerIDTextBox" Height="35" Padding="10"
                                 BorderBrush="#CED4DA" BorderThickness="1"
                                 FontSize="13"/>
                    </StackPanel>

                    <!-- Employee ID -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,15">
                        <Label Content="Employee ID:" FontWeight="Medium" Padding="0,0,0,5" 
                               Foreground="#495057"/>
                        <TextBox x:Name="EmployeeIDTextBox" Height="35" Padding="10"
                                 BorderBrush="#CED4DA" BorderThickness="1"
                                 FontSize="13"/>
                    </StackPanel>

                    <!-- Order Date -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,20">
                        <Label Content="Order Date:" FontWeight="Medium" Padding="0,0,0,5" 
                               Foreground="#495057"/>
                        <DatePicker x:Name="OrderDatePicker" Height="35" 
                                   BorderBrush="#CED4DA" BorderThickness="1" 
                                   FontSize="13"/>
                    </StackPanel>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" 
                               Margin="0,15,0,0">
                        <Button Content="Save" Width="90" Height="38" Margin="0,0,15,0"
                                Background="#007ACC" Foreground="White" BorderThickness="0"
                                Click="SaveButton_Click" Cursor="Hand" 
                                FontWeight="Medium" FontSize="13">
                            <Button.Effect>
                                <DropShadowEffect Color="#007ACC" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                            </Button.Effect>
                        </Button>
                        <Button Content="Cancel" Width="90" Height="38"
                                Background="#6C757D" Foreground="White" BorderThickness="0"
                                Click="CancelButton_Click" Cursor="Hand" 
                                FontWeight="Medium" FontSize="13">
                            <Button.Effect>
                                <DropShadowEffect Color="#6C757D" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                            </Button.Effect>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
