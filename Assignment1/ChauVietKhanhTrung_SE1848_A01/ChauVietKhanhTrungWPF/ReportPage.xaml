<Window x:Class="ChauVietKhanhTrungWPF.ReportPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChauVietKhanhTrungWPF"
        mc:Ignorable="d"
        Title="ReportPage" Height="450" Width="800"
         WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Margin="20" Background="#F8F9FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filter panel -->
        <Border x:Name="BackToAdmin_Click1" Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" 
        CornerRadius="8" Padding="20" Margin="0,0,0,15">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" DockPanel.Dock="Left">
                    <!-- ...các control như cũ... -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="From:" VerticalAlignment="Center" FontWeight="Medium" 
                          Foreground="#495057" Margin="0,0,8,0"/>
                        <DatePicker x:Name="FromDatePicker" Width="140" Height="32" 
                           BorderBrush="#CED4DA" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="25,0,0,0">
                        <TextBlock Text="To:" VerticalAlignment="Center" FontWeight="Medium" 
                          Foreground="#495057" Margin="0,0,8,0"/>
                        <DatePicker x:Name="ToDatePicker" Width="140" Height="32" 
                           BorderBrush="#CED4DA" BorderThickness="1"/>
                    </StackPanel>

                    <Button Content="Generate Report" Margin="25,0,0,0" Click="GenerateReport_Click" 
                    Width="130" Height="36" Background="#007BFF" Foreground="White" 
                    BorderThickness="0" FontWeight="Medium" Cursor="Hand">
                        <Button.Effect>
                            <DropShadowEffect Color="#007BFF" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>

                <!-- Spacer để đẩy nút về bên phải -->
                <DockPanel DockPanel.Dock="Right" Width="Auto">
                    <Button  Content="Back to Admin" Width="130" Height="36" Margin="30,0,0,0"
                    Background="#6C757D" Foreground="White" BorderThickness="0"  
                    FontWeight="Medium" Cursor="Hand" Click="BackToAdmin_Click"/>
                </DockPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" 
        CornerRadius="8" Padding="1" Margin="0,0,0,0">
            <DataGrid x:Name="OrderDataGrid"
              AutoGenerateColumns="True"
              Background="Transparent" BorderThickness="0"
              GridLinesVisibility="Horizontal"
              HeadersVisibility="Column" CanUserAddRows="False"
              AlternatingRowBackground="#F8F9FA" RowHeight="35"
              FontSize="13" Foreground="#495057"/>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" 
            CornerRadius="8" Padding="20" Margin="0,15,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Border Background="#E8F4FD" BorderBrush="#007BFF" BorderThickness="1" 
                    CornerRadius="6" Padding="15,10">
                <TextBlock x:Name="TotalOrdersText" FontWeight="Bold" FontSize="16" 
                          Foreground="#007BFF" Text="Total Orders: 0"/>
            </Border>
            
            <Border Background="#E8F5E8" BorderBrush="#28A745" BorderThickness="1" 
                    CornerRadius="6" Padding="15,10" Margin="20,0,0,0">
                <TextBlock x:Name="TotalRevenueText" FontWeight="Bold" FontSize="16" 
                          Foreground="#28A745" Text="Total Revenue: $0.00"/>
            </Border>
        </StackPanel>
    </Border>

    </Grid>
</Window>
