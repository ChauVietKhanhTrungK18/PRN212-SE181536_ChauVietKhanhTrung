<Window x:Class="ChauVietKhanhTrungWPF.OrderDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm chi tiết đơn hàng" Height="420" Width="520" WindowStartupLocation="CenterOwner"
        >
    <Grid Background="#F8F9FA" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Nhập chi tiết đơn hàng" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,10,0,0">
            <Label Content="Sản phẩm:" Width="90"/>
            <ComboBox x:Name="ProductComboBox" Width="200" DisplayMemberPath="ProductName"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,10,0,0">
            <Label Content="Số lượng:" Width="90"/>
            <TextBox x:Name="QuantityTextBox" Width="70"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,10,0,0">
            <Label Content="Giảm giá:" Width="90"/>
            <TextBox x:Name="DiscountTextBox" Width="70" Text="0"/>
        </StackPanel>
        <Button Content="Thêm sản phẩm" Grid.Row="4" Height="35" Margin="0,18,0,0"
                Background="#2563EB" Foreground="White" Width="160"
                Click="AddProduct_Click"/>

        <DataGrid x:Name="OrderDetailGrid" Grid.Row="5" Margin="0,16,0,0" AutoGenerateColumns="True"
                  Height="140" IsReadOnly="True"/>
        <Button Content="Xong" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,14,0,0"
                Grid.Row="6" Width="90" Height="35" Click="Done_Click"/>
    </Grid>
</Window>
