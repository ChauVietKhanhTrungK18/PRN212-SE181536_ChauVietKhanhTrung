<Window x:Class="ChauVietKhanhTrungWPF.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChauVietKhanhTrungWPF"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="LoginPage" Height="450" Width="800">

    <Window.Resources>
        <!-- Keep your styles for TextBox, PasswordBox, and Button as is -->
    </Window.Resources>

    <Grid Background="#E8F4FD">
        <!-- A simple background color for testing -->

        <!-- Main Card -->
        <Border Width="400" Height="420" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Background="White" 
                CornerRadius="15">

            <StackPanel Margin="40,30">
                <!-- Title -->
                <TextBlock Text="Đăng Nhập" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          HorizontalAlignment="Center" 
                          Foreground="#2C3E50" 
                          Margin="0,0,0,30"/>

                <!-- Username Section -->
                <TextBlock Text="Username:" 
                          FontSize="14" 
                          Foreground="#34495E" 
                          Margin="0,0,0,8"/>

                <TextBox x:Name="UsernameTextBox" 
                        FontSize="14" 
                        Padding="12,10" 
                        Background="White" 
                        BorderBrush="#BDC3C7" 
                        BorderThickness="1.5"
                        Height="40"/>

                <!-- Password Section -->
                <TextBlock Text="Password:" 
                          FontSize="14" 
                          Foreground="#34495E" 
                          Margin="0,15,0,8"/>

                <PasswordBox x:Name="PasswordBox" 
                            FontSize="14" 
                            Padding="12,10" 
                            Background="White" 
                            BorderBrush="#BDC3C7" 
                            BorderThickness="1.5"
                            Height="40"/>

                <!-- Phone Section -->
                <TextBlock Text="Phone Number:" 
                          FontSize="14" 
                          Foreground="#34495E" 
                          Margin="0,15,0,8"/>

                <TextBox x:Name="PhoneTextBox" 
                        FontSize="14" 
                        Padding="12,10" 
                        Background="White" 
                        BorderBrush="#BDC3C7" 
                        BorderThickness="1.5"
                        Height="40"/>

                <!-- Login Button -->
                <Button Content="Login" 
                       Height="45"
                       Background="#4CAF50" 
                       Foreground="White" 
                       FontSize="16" 
                       FontWeight="SemiBold" 
                       BorderThickness="0"
                       Margin="0,25,0,0"
                       Cursor="Hand"
                       Click="LoginButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
